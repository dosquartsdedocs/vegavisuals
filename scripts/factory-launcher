#!/usr/bin/env bash
set -euo pipefail

FACTORY_ROOT="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
OPERATION="${1:?factory operation is required}"
shift

CLI=""

bootstrap() {
  CLI="$(env -u MCP_CONSUMER_WORKSPACE make --silent --no-print-directory -C "${FACTORY_ROOT}" mcp-cli-path)"
  [[ -x "${CLI}" ]] || {
    printf 'vegavisuals MCP CLI is unavailable: %s\n' "${CLI}" >&2
    exit 1
  }
}

case "${OPERATION}" in
  build)
    bootstrap
    "${CLI}" --project "${FACTORY_ROOT}" install-check --command "${CLI}" >/dev/null
    "${CLI}" --project "${FACTORY_ROOT}" ensure-renderer >/dev/null
    ;;
  init)
    PROJECT_ROOT="${1:?consumer project root is required}"
    shift
    bootstrap
    exec "${CLI}" --project "${PROJECT_ROOT}" init "$@"
    ;;
  check)
    bootstrap
    exec "${CLI}" --project "${FACTORY_ROOT}" factory-lifecycle-check --command "${CLI}" "$@"
    ;;
  tests)
    exec make --no-print-directory -C "${FACTORY_ROOT}" tests
    ;;
  smoke)
    exec make --no-print-directory -C "${FACTORY_ROOT}" mcp-smoke
    ;;
  down)
    PROJECT_ROOT="${1:?consumer project root is required}"
    shift
    bootstrap
    exec "${CLI}" --project "${PROJECT_ROOT}" down "$@"
    ;;
  down-all)
    bootstrap
    exec "${CLI}" --project "${FACTORY_ROOT}" down-all "$@"
    ;;
  update)
    bootstrap
    exec "${CLI}" --project "${FACTORY_ROOT}" update "$@"
    ;;
  release-status)
    bootstrap
    exec "${CLI}" --project "${FACTORY_ROOT}" release-status "$@"
    ;;
  install-check)
    bootstrap
    exec "${CLI}" --project "${FACTORY_ROOT}" install-check --command "${CLI}" "$@"
    ;;
  install-codex-mcp)
    PROJECT_ROOT="${1:?consumer project root is required}"
    shift
    bootstrap
    exec "${CLI}" --project "${PROJECT_ROOT}" install-codex-mcp --workspace "${PROJECT_ROOT}" "$@"
    ;;
  factory-check)
    bootstrap
    exec "${CLI}" --project "${FACTORY_ROOT}" factory-check "$@"
    ;;
  serve)
    PROJECT_ROOT="${1:-${MCP_CONSUMER_WORKSPACE:-}}"
    [[ -n "${PROJECT_ROOT}" ]] || {
      printf 'Consumer project root is required\n' >&2
      exit 2
    }
    if [[ $# -gt 0 ]]; then
      shift
    fi
    bootstrap
    "${CLI}" --project "${PROJECT_ROOT}" install-check --command "${CLI}" >/dev/null
    "${CLI}" --project "${PROJECT_ROOT}" ensure-renderer >/dev/null
    exec "${CLI}" --project "${PROJECT_ROOT}" mcp serve "$@"
    ;;
  client-config)
    bootstrap
    exec "${CLI}" --project "${FACTORY_ROOT}" mcp client-config --command "${CLI}" "$@"
    ;;
  manifest)
    bootstrap
    exec "${CLI}" --project "${FACTORY_ROOT}" factory-manifest "$@"
    ;;
  render)
    PROJECT_ROOT="${1:?consumer project root is required}"
    shift
    bootstrap
    exec "${CLI}" --project "${PROJECT_ROOT}" render "$@"
    ;;
  render-all)
    PROJECT_ROOT="${1:?consumer project root is required}"
    shift
    bootstrap
    exec "${CLI}" --project "${PROJECT_ROOT}" render-all "$@"
    ;;
  *)
    printf 'Unknown factory operation: %s\n' "${OPERATION}" >&2
    exit 2
    ;;
esac
